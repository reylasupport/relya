# ML Kit and sign_in_with_apple both need a modern floor; 15.5 is the lowest
# version every dependency in this project supports.
platform :ios, '15.5'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in Generated.xcconfig. Try deleting Generated.xcconfig, then run flutter pub get."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Creating the share-extension target needs Xcode, and it does not exist in
# Runner.xcodeproj yet. Declaring it here unconditionally does not just skip
# it - CocoaPods refuses to install anything at all, so `pod install` aborts
# for the whole project and the iOS build never even starts compiling.
#
# Detected rather than commented out, so the declaration below starts applying
# by itself the moment the target is added, with nothing to remember.
ios_dir = File.dirname(File.realpath(__FILE__))
has_share_extension = Xcodeproj::Project
  .open(File.join(ios_dir, 'Runner.xcodeproj'))
  .targets.map(&:name)
  .include?('ShareExtension')

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods ios_dir

  if has_share_extension
    # Its own bundle, but the same Flutter pods setup, so it compiles against
    # the shared app group.
    target 'ShareExtension' do
      inherit! :search_paths
    end
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      # Required by permission_handler: permissions not listed here are
      # compiled out entirely, so the binary cannot even ask for them.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_EVENTS=0',
        'PERMISSION_LOCATION=0',
        'PERMISSION_MICROPHONE=0',
        'PERMISSION_CONTACTS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_CRITICAL_ALERTS=0',
      ]
    end
  end
end
