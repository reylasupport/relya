# Server-side configuration for Supabase Edge Functions.
#
# NONE of these values may ever appear in the mobile app. They are set with:
#   supabase secrets set --env-file .env
# and are readable only inside Edge Functions. The client-side, publishable
# configuration lives in mobile/env/example.json instead.

# ---------------------------------------------------------------- model ----

# Which adapter to use: anthropic | openai
AI_PROVIDER=anthropic

# Only the key for the provider selected above is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides. The large model reads images and anything long; the small
# one handles text that on-device OCR already extracted, which is most captures
# and most of the cost saving.
AI_MODEL_LARGE=claude-sonnet-5
AI_MODEL_SMALL=claude-haiku-4-5-20251001

# ------------------------------------------------------------- supabase ----

# Injected automatically in deployed functions. Only needed for local serving.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bypasses Row Level Security. Never leaves the server, never goes in a client,
# never goes in CI logs.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------- revenuecat ----

# Shared secret checked by the webhook. Without it, anyone who finds the URL
# can grant themselves a subscription.
REVENUECAT_WEBHOOK_SECRET=
